{
  "openapi": "3.0.3",
  "info": {
    "title": "Order Service API",
    "version": "1.0.0",
    "description": "Order Management and Checkout Microservice for E-Commerce Platform"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8083",
      "description": "Order Service Direct Port"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer Token with ROLE_CUSTOMER, ROLE_ADMIN, or ROLE_WAREHOUSE"
      }
    },
    "schemas": {
      "OrderItemRequest": {
        "type": "object",
        "required": ["productId", "quantity"],
        "properties": {
          "productId": {
            "type": "string",
            "example": "660c1f102f1d2b3a4c5e6f7b"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/OrderItemRequest"
            }
          }
        }
      },
      "UpdateOrderStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["PLACED", "CONFIRMED", "SHIPPED", "DELIVERED", "CANCELLED"],
            "example": "CONFIRMED"
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "unitPrice": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "660c20452f1d2b3a4c5e6f7c"
          },
          "userEmail": {
            "type": "string",
            "format": "email",
            "example": "customer1@demo.local"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "totalAmount": {
            "type": "number",
            "format": "double",
            "example": 399.98
          },
          "status": {
            "type": "string",
            "enum": ["PLACED", "CONFIRMED", "SHIPPED", "DELIVERED", "CANCELLED"],
            "example": "PLACED"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/orders": {
      "post": {
        "tags": ["Orders"],
        "summary": "Create a new customer order",
        "description": "Places an order for the authenticated customer. Validates product availability with Product Service via inter-service HTTP request.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Duplicate product IDs or inactive product"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Access denied (requires ROLE_CUSTOMER)"
          },
          "502": {
            "description": "Bad Gateway - Product verification failure with Product Service"
          }
        }
      },
      "get": {
        "tags": ["Orders"],
        "summary": "Get all orders (Admin only)",
        "description": "Administrative endpoint to list every order in the database.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of all orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Access denied (requires ROLE_ADMIN)"
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get order by ID",
        "description": "Retrieves order details. ADMIN role can look up any order ID. CUSTOMER role is routed to ownership lookup logic.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Order identifier (for ADMIN) or customer email query path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Access denied"
          },
          "404": {
            "description": "Order not found"
          }
        }
      },
      "delete": {
        "tags": ["Orders"],
        "summary": "Cancel an order",
        "description": "Cancels a placed order owned by the authenticated customer.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Order identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order successfully cancelled"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Access denied or order does not belong to user"
          },
          "404": {
            "description": "Order not found"
          },
          "409": {
            "description": "Order cannot be cancelled (not in PLACED status)"
          }
        }
      }
    },
    "/orders/{id}/status": {
      "patch": {
        "tags": ["Orders"],
        "summary": "Update order status",
        "description": "Transitions an order through delivery lifecycle (PLACED -> CONFIRMED -> SHIPPED -> DELIVERED). Intended for ADMIN or WAREHOUSE roles.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Order identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Invalid status request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Access denied"
          },
          "404": {
            "description": "Order not found"
          },
          "409": {
            "description": "Invalid status transition"
          }
        }
      }
    }
  }
}
